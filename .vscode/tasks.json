{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start API",
      "type": "shell",
      // Reuse an API that is already up (a leftover from a previous session, or the
      // other half of the compound launch) instead of failing to bind port 8000 and
      // taking the browser launch down with it.
      "command": "python -c \"import urllib.request,sys;urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=2);print('Uvicorn running on (reusing existing API)');sys.exit(0)\" 2>$null; if (-not $?) { python -m uvicorn api.server:app --port 8000 }",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}", "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "problemMatcher": {
        "pattern": { "regexp": "^\\s*$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Started server process|Will watch).*",
          "endsPattern": ".*(Application startup complete|Uvicorn running on).*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Install deps",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build how-it-works page",
      "type": "shell",
      "command": "python scripts/build_how_it_works.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Generate sample data",
      "type": "shell",
      "command": "python scripts/generate_sample.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "python tests/test_metrics.py && python tests/test_report.py",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
