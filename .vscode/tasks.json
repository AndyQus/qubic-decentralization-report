{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start API",
      "type": "shell",
      // Reuse an API that is already up (a leftover from a previous session, or the
      // other half of the compound launch) instead of failing to bind port 8000 and
      // taking the browser launch down with it.
      //
      // The logic lives in a script rather than inline: an inline Python one-liner
      // here carried quotes, commas and `timeout=2` through a JSON string into a
      // PowerShell -Command argument, VS Code re-quoted it on the way, and
      // PowerShell ended up parsing `timeout=2` as its own expression — F5 failed
      // with "Ausdruck nach "," fehlt" before the API was ever started. One file
      // path has nothing left to re-quote.
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass",
               "-File", "${workspaceFolder}/scripts/start_api.ps1"],
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "pattern": { "regexp": "^\\s*$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          // "Starting API" is the script's own first line, so the reuse path
          // (which prints only the "Uvicorn running on ..." end line) and the
          // cold-start path both produce a begin/end pair.
          "beginsPattern": ".*(Starting API|Started server process|Will watch).*",
          "endsPattern": ".*(Application startup complete|Uvicorn running on).*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Install deps",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build how-it-works page",
      "type": "shell",
      "command": "python scripts/build_how_it_works.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Generate sample data",
      "type": "shell",
      "command": "python scripts/generate_sample.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "python tests/test_metrics.py && python tests/test_report.py",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
