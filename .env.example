# Optional settings for docker compose. The report needs NO secrets — it reads
# only public RPC data — so this file is convenience, not a requirement.
#
# Usage on the server:
#   1. cp .env.example .env
#   2. adjust values
#   3. docker compose up -d   (Compose reads .env automatically)

# Qubic RPC endpoint the report is built from. Point this at your own node or a
# mirror if you don't want to depend on the public endpoint.
QUBIC_RPC_BASE=https://rpc.qubic.org

# Self-reporting registry. Leave unset to use the pools.json baked into the image;
# set it to run your own (mount it via the volume in docker-compose.yaml).
#QDR_REGISTRY=/data/pools.json

# Persistent store (CONCEPT §5.1). Defaults to $DATA_DIR/qdr.db, i.e. inside the
# volume — closed epochs are sealed there and survive restarts and RPC outages.
#QDR_DB=/data/qdr.db

# How stale the running epoch may get (seconds) before a request recomputes it.
# Closed epochs are never recomputed, so this only affects the live epoch.
#QDR_LIVE_MAX_AGE=300

# Arbitrator identity used to derive per-computor revenue. Still unverified in the
# bundled default — run `python scripts/ingest.py --verify-arbitrator` and set the
# confirmed identity here (see docs/DATA_SOURCES.md §4).
#QUBIC_ARBITRATOR=

# Bob node — the ONLY public source that carries the protocol's epoch-end computor
# payouts (docs/DATA_SOURCES.md §7). Defaults to the public instance; point this at
# your own node (RPC port 40420) so the report does not depend on someone else's.
#QDR_BOB_URL=http://10.0.0.5:40420

# Live pulse cache (seconds). The tick moves ~2.7/s, so a few seconds of caching
# costs nothing and protects the upstream from many dashboards polling at once.
#QDR_PULSE_TTL=10
