# Data caches (raw API pulls) — keep the registry, ignore bulk pulls
data/raw/*
!data/raw/.gitkeep

# Bob end-epoch log cache: large, refetchable, and per-deployment
data/bob/

# The persistent store is runtime state, not source: it belongs in the volume
# (DATA_DIR), and each deployment builds its own history.
data/*.db
data/*.db-wal
data/*.db-shm

# Worker runtime state. The log is the tail /log.html serves, the lock is how
# start_worker.ps1 refuses to be the second writer against one SQLite file, and
# the .lnk is what Git Bash leaves behind where worker.sh makes its FIFO (MSYS
# emulates the named pipe with a shortcut). All three are per-machine.
data/worker.log
data/worker.lock
data/.worker.fifo*

# Node / build
node_modules/
dist/
build/
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# verification screenshots (scratch)
scripts/shot_*.png

# Burn-page verification screenshots. scripts/verify_burn_page.py renders these
# against whatever store is running - often a preview store with invented
# figures, so they must never be committed as though they showed measurements.
scripts/burn_*.png

# Price-page verification screenshots, same reasoning as the burn ones above:
# scripts/verify_price_page.py renders against whatever store is running, which
# in development holds simulated prices. They must never be committed as though
# they showed a real market.
scripts/price_*.png
scripts/hero_*.png
# Einzelaufnahmen aus der Handprüfung, die keinem der Präfixe oben folgen. Sie
# entstehen gegen denselben Entwicklungs-Store und zeigen damit dieselben
# simulierten Preise — sie gehören aus demselben Grund nicht ins Repo.
scripts/live_*.png

# Branding-Prüfbilder aus scripts/verify_branding.py. Dieselbe Begründung wie
# oben: Sie entstehen gegen den laufenden Store. Die ausgelieferten Icons sind
# etwas anderes — die liegen unter dashboard/assets/ und gehören ins Repo, weil
# das Laufzeit-Image sie nicht erzeugen kann (kein Pillow, kein SVG-Renderer).
scripts/brand_*.png
