# Data caches (raw API pulls) — keep the registry, ignore bulk pulls
data/raw/*
!data/raw/.gitkeep

# Bob end-epoch log cache: large, refetchable, and per-deployment
data/bob/

# The persistent store is runtime state, not source: it belongs in the volume
# (DATA_DIR), and each deployment builds its own history.
data/*.db
data/*.db-wal
data/*.db-shm

# Node / build
node_modules/
dist/
build/
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# verification screenshots (scratch)
scripts/shot_*.png
